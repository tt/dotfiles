[alias]
	aa = add --all
	ai = add --interactive
	br = branch
	ca = commit --amend
	ci = commit
	co = checkout
	dc = diff --cached
	di = diff
	ff = merge --ff-only
	lg = log --graph
	st = status
[branch]
        sort = -committerdate
[commit]
	verbose = true
[core]
	pager = delta --diff-highlight | less -R
[diff]
	colorMoved = dimmed-zebra
	colorMovedWS = allow-indentation-change
[fetch]
	prune = true
[gpg]
	format = ssh
[gpg "ssh"]
	defaultKeyCommand = ssh-add -L
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only --diff-highlight
[merge]
	ff = false
[pull]
	ff = only
[rebase]
	autoSquash = true
[user]
	email = troels@thomsen.io
	name = Troels Thomsen
